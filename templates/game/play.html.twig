{% extends 'base.html.twig' %}

{% block title %}{{ character.name }} — SymfonyForever{% endblock %}

{% block stylesheets %}
<style>
    html, body { width: 100%; height: 100%; overflow: hidden; user-select: none; }
    #game-viewport { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
    #floating-layer { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 15; }
    #hud { position: fixed; inset: 0; pointer-events: none; z-index: 20; font-size: 13px; }
    .hud-box {
        pointer-events: auto;
        background: rgba(9, 19, 30, 0.82);
        border: 1px solid rgba(148, 189, 224, 0.28);
        border-radius: 12px;
        backdrop-filter: blur(8px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.45);
    }

    /* Top-left: Player + Party */
    .hud-top-left { position: absolute; top: 14px; left: 14px; width: 280px; display: flex; flex-direction: column; gap: 10px; }
    .unit-frame { padding: 10px 12px; }
    .unit-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .unit-name { font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 6px; }
    .lvl-badge { background: rgba(250, 204, 21, 0.18); border: 1px solid rgba(250, 204, 21, 0.5); color: #fde047; padding: 1px 6px; border-radius: 999px; font-size: 11px; font-weight: 700; white-space: nowrap; flex-shrink: 0; }
    .bar { position: relative; height: 15px; background: rgba(0,0,0,0.55); border-radius: 6px; overflow: hidden; margin-bottom: 5px; border: 1px solid rgba(255,255,255,0.08); }
    .bar-fill { height: 100%; transition: width 0.2s ease; }
    .bar-hp .bar-fill { background: linear-gradient(90deg, #16a34a, #22c55e); }
    .bar-hp-enemy .bar-fill { background: linear-gradient(90deg, #b91c1c, #ef4444); }
    .bar-mp .bar-fill { background: linear-gradient(90deg, #2563eb, #38bdf8); }
    .bar-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; text-shadow: 0 1px 2px #000; }
    .buff-row { display: flex; gap: 5px; flex-wrap: wrap; margin-top: 4px; }
    .buff-pill { font-size: 10px; padding: 2px 6px; border-radius: 6px; background: rgba(56,189,248,0.22); border: 1px solid rgba(56,189,248,0.5); }

    /* Party */
    .party-box { padding: 9px 11px; }
    .party-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
    .party-member {
        padding: 5px 7px; border-radius: 8px; background: rgba(255,255,255,0.04);
        margin-bottom: 5px; cursor: pointer; border: 1px solid transparent;
    }
    .party-member:hover, .party-member.targeted { border-color: #34d399; background: rgba(16,185,129,0.12); }
    .party-invite-row { display: flex; gap: 4px; margin-top: 6px; }
    .party-invite-row input {
        flex: 1; min-width: 0; padding: 4px 7px; border-radius: 7px;
        border: 1px solid var(--border); background: rgba(0,0,0,0.45); color: #fff; font-size: 12px;
    }
    .mini-btn {
        padding: 4px 8px; border-radius: 7px; border: 1px solid var(--border);
        background: rgba(56,189,248,0.2); color: #e0f2fe; cursor: pointer; font-size: 11px; font-weight: 600;
    }
    .mini-btn:hover { background: rgba(56,189,248,0.38); }
    .mini-btn-red { background: rgba(239,68,68,0.22); color: #fecaca; }

    /* Top-center: Target Frame & World Boss Raid Bar */
    .hud-target { position: absolute; top: 14px; left: 50%; transform: translateX(-50%); width: 336px; display: none; }
    .hud-target.visible { display: block; }
    .aggro-tag { font-size: 11px; color: #fdba74; margin-top: 2px; }

    #world-boss-hud {
        position: absolute; top: 96px; left: 50%; transform: translateX(-50%);
        width: 460px; max-width: calc(100vw - 560px); min-width: 320px;
        padding: 10px 14px; display: none; z-index: 25;
        background: linear-gradient(180deg, rgba(40, 10, 12, 0.92), rgba(14, 16, 26, 0.92));
        border: 1px solid rgba(249, 115, 22, 0.72);
        box-shadow: 0 0 28px rgba(220, 38, 38, 0.45), 0 12px 28px rgba(0, 0, 0, 0.6);
    }
    #world-boss-hud.visible { display: block; }
    .wb-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 6px; }
    .wb-title { font-weight: 800; font-size: 13px; color: #fef08a; letter-spacing: 0.03em; display: flex; align-items: center; gap: 6px; }
    .wb-badge {
        font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 999px;
        background: rgba(239, 68, 68, 0.25); border: 1px solid rgba(248, 113, 113, 0.7); color: #fecaca;
        text-transform: uppercase;
    }
    .wb-badge.phase2 { background: rgba(249, 115, 22, 0.35); border-color: #facc15; color: #fef08a; animation: pulseGold 1.2s infinite; }
    .wb-bar { position: relative; height: 18px; background: rgba(0, 0, 0, 0.68); border-radius: 8px; overflow: hidden; border: 1px solid rgba(251, 146, 60, 0.45); }
    .wb-bar-fill { height: 100%; background: linear-gradient(90deg, #991b1b, #ef4444, #f97316); transition: width 0.25s ease; }
    .wb-bar-notch { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: rgba(254, 240, 138, 0.7); pointer-events: none; }
    .wb-meta { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px; margin-top: 6px; font-size: 11px; color: #fed7aa; }
    .wb-pill {
        padding: 2px 7px; border-radius: 999px; font-size: 10px; font-weight: 700;
        background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .wb-pill.warn { background: rgba(239, 68, 68, 0.25); border-color: rgba(248, 113, 113, 0.65); color: #fecaca; }
    .wb-pill.ok { background: rgba(16, 185, 129, 0.22); border-color: rgba(52, 211, 153, 0.6); color: #a7f3d0; }
    .wb-pill.leg { background: rgba(249, 115, 22, 0.22); border-color: rgba(251, 146, 60, 0.7); color: #fdba74; }

    #wb-minimap-pill {
        font-size: 11px; padding: 5px 8px; border-radius: 8px; cursor: pointer;
        background: rgba(220, 38, 38, 0.16); border: 1px solid rgba(249, 115, 22, 0.5);
        color: #fed7aa; display: flex; justify-content: space-between; align-items: center; gap: 6px;
        transition: background 0.15s ease;
    }
    #wb-minimap-pill:hover { background: rgba(220, 38, 38, 0.3); }
    #wb-minimap-pill.dead { background: rgba(15, 23, 42, 0.6); border-color: rgba(148, 163, 184, 0.3); color: #94a3b8; }

    /* Top-right: Minimap, Zone & Quest Tracker */
    .hud-top-right-col { position: absolute; top: 14px; right: 14px; width: 230px; display: flex; flex-direction: column; gap: 8px; }
    .hud-top-right { padding: 10px; display: flex; flex-direction: column; gap: 7px; }
    .quest-tracker { padding: 9px 11px; font-size: 12px; }
    .qt-head { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #fde047; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 6px; }
    .qt-item { padding: 6px 8px; border-radius: 8px; background: rgba(255,255,255,0.04); border-left: 3px solid #facc15; margin-bottom: 5px; }
    .qt-item.ready { border-left-color: #34d399; background: rgba(16,185,129,0.14); }
    .qt-item-title { font-weight: 700; color: #fef3c7; font-size: 12px; margin-bottom: 2px; }
    .qt-item-obj { font-size: 11px; color: #cbd5e1; }
    .qt-dist { font-size: 10px; color: #5eead4; margin-top: 3px; }

    #npc-interact-prompt, #loot-pickup-prompt {
        position: absolute; bottom: 162px; left: 50%; transform: translateX(-50%);
        background: rgba(11, 24, 38, 0.92); border: 1px solid rgba(250, 204, 21, 0.65);
        color: #fef08a; padding: 6px 14px; border-radius: 999px; font-weight: 600; font-size: 12px;
        display: none; pointer-events: auto; cursor: pointer; box-shadow: 0 8px 24px rgba(0,0,0,0.5); z-index: 28;
    }
    #loot-pickup-prompt { bottom: 196px; border-color: rgba(52, 211, 153, 0.75); color: #a7f3d0; }
    #npc-interact-prompt.visible, #loot-pickup-prompt.visible { display: inline-flex; align-items: center; gap: 6px; }

    .modal-tabs { display: flex; gap: 6px; margin-bottom: 12px; }
    .modal-tab {
        flex: 1; padding: 7px 10px; border-radius: 9px; border: 1px solid var(--border);
        background: rgba(255,255,255,0.04); color: var(--text-muted); cursor: pointer; font-weight: 700; font-size: 12px;
    }
    .modal-tab.active { background: rgba(250, 204, 21, 0.16); border-color: rgba(250, 204, 21, 0.55); color: #fef08a; }

    .inv-layout { display: grid; grid-template-columns: 235px 1fr; gap: 14px; }
    @media (max-width: 720px) { .inv-layout { grid-template-columns: 1fr; } }
    .equip-slot-card {
        padding: 8px 10px; border-radius: 10px; background: rgba(255,255,255,0.04);
        border: 1px solid rgba(148,189,224,0.22); margin-bottom: 7px;
    }
    .equip-slot-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 3px; }
    .bag-list { max-height: 360px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px; padding-right: 4px; }
    .bag-row {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 7px 9px; border-radius: 9px; background: rgba(255,255,255,0.04);
        border-left: 3px solid #94a3b8;
    }
    .bag-row-main { min-width: 0; flex: 1; }
    .bag-row-title { font-weight: 700; font-size: 12.5px; display: flex; align-items: center; gap: 5px; }
    .bag-row-sub { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
    .bag-row-actions { display: flex; gap: 4px; flex-shrink: 0; }
    .gold-pill { color: #fde047; font-weight: 700; font-size: 12px; }

    .quest-card-modal {
        padding: 10px 12px; border-radius: 10px; margin-bottom: 9px;
        background: rgba(255,255,255,0.04); border: 1px solid rgba(148,189,224,0.22);
    }
    .quest-card-modal.ready { border-color: rgba(52,211,153,0.55); background: rgba(16,185,129,0.1); }
    .quest-card-modal.available { border-color: rgba(250,204,21,0.55); background: rgba(250,204,21,0.07); }
    .quest-card-modal h4 { margin: 0 0 4px; font-size: 0.98rem; color: #fef3c7; display: flex; justify-content: space-between; align-items: center; }
    .quest-card-modal p { margin: 0 0 8px; font-size: 0.84rem; color: var(--text-muted); line-height: 1.45; }
    .quest-reward-line { font-size: 0.8rem; color: #c084fc; margin-bottom: 8px; font-weight: 600; }

    .zone-header { display: flex; justify-content: space-between; align-items: center; }
    .zone-title { font-weight: 700; font-size: 13px; color: #e0f2fe; }
    .zone-sub { font-size: 11px; color: var(--text-muted); }
    #minimap-canvas { width: 202px; height: 202px; border-radius: 10px; border: 1px solid rgba(94, 234, 212, 0.35); display: block; }
    .net-row { display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: var(--text-muted); }
    .net-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22c55e; margin-right: 4px; }
    .atmo-row {
        display: flex; align-items: center; justify-content: space-between; gap: 6px;
        padding: 4px 8px; border-radius: 7px; font-size: 11px; font-weight: 600;
        background: rgba(15, 29, 44, 0.78); border: 1px solid rgba(94, 234, 212, 0.28);
        color: #e2e8f0;
    }
    .atmo-row.admin-clickable { cursor: pointer; }
    .atmo-row.admin-clickable:hover { border-color: rgba(250, 204, 21, 0.6); background: rgba(24, 42, 62, 0.88); }

    /* Floating Admin Atmosphere Panel (/iddad) */
    #admin-atmosphere-panel {
        position: absolute; top: 14px; left: 306px; width: 292px; padding: 11px 12px;
        display: none; z-index: 32;
        background: linear-gradient(180deg, rgba(16, 26, 40, 0.94), rgba(9, 17, 27, 0.94));
        border: 1px solid rgba(250, 204, 21, 0.52);
        box-shadow: 0 14px 36px rgba(0, 0, 0, 0.6), 0 0 22px rgba(250, 204, 21, 0.12);
    }
    #admin-atmosphere-panel.visible { display: flex; flex-direction: column; gap: 10px; }
    .admin-panel-head { display: flex; justify-content: space-between; align-items: center; gap: 6px; }
    .admin-panel-title { font-weight: 800; font-size: 12.5px; color: #fde047; display: flex; align-items: center; gap: 5px; }
    .admin-panel-badge {
        font-size: 9.5px; font-weight: 700; padding: 2px 6px; border-radius: 999px;
        background: rgba(94, 234, 212, 0.16); border: 1px solid rgba(94, 234, 212, 0.45); color: #99f6e4;
    }
    .admin-section-label {
        font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em;
        color: #93adc2; font-weight: 700; margin-bottom: 5px;
        display: flex; justify-content: space-between; align-items: center;
    }
    .admin-btn-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }
    .admin-preset-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; }
    .admin-btn-row { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
    .admin-btn {
        padding: 5px 6px; border-radius: 7px; border: 1px solid rgba(148, 189, 224, 0.25);
        background: rgba(15, 29, 44, 0.85); color: #e2e8f0; cursor: pointer;
        font-size: 11px; font-weight: 600; text-align: center; transition: background 0.12s ease, border-color 0.12s ease;
    }
    .admin-btn:hover { background: rgba(56, 189, 248, 0.2); border-color: rgba(94, 234, 212, 0.55); }
    .admin-btn.active {
        background: rgba(250, 204, 21, 0.22); border-color: #facc15; color: #fef08a;
        box-shadow: 0 0 10px rgba(250, 204, 21, 0.28);
    }
    .admin-btn.warn { background: rgba(234, 88, 12, 0.22); border-color: rgba(251, 146, 60, 0.55); color: #fed7aa; }
    .admin-btn.warn.active { background: rgba(239, 68, 68, 0.28); border-color: #f87171; color: #fecaca; }
    .admin-time-readout-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; font-size: 12px; }
    #admin-time-readout { font-weight: 700; color: #fef3c7; }
    #admin-time-mode-badge {
        font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 999px;
        background: rgba(148, 163, 184, 0.2); border: 1px solid rgba(148, 163, 184, 0.4); color: #cbd5e1;
    }
    #admin-time-mode-badge.overridden { background: rgba(250, 204, 21, 0.18); border-color: rgba(250, 204, 21, 0.55); color: #fde047; }
    #admin-time-mode-badge.frozen { background: rgba(239, 68, 68, 0.22); border-color: rgba(248, 113, 113, 0.65); color: #fecaca; }
    #admin-time-slider { width: 100%; accent-color: #facc15; cursor: pointer; margin: 2px 0 6px; }
    @media (max-width: 1150px) {
        #admin-atmosphere-panel { left: 14px; top: auto; bottom: 230px; }
    }
    .travel-row { display: flex; gap: 4px; }
    .travel-row select {
        flex: 1; min-width: 0; background: rgba(5,13,21,0.85); color: #e2e8f0;
        border: 1px solid var(--border); border-radius: 7px; padding: 4px 6px; font-size: 11px;
    }

    /* Bottom-center: Action bar + XP */
    .hud-bottom-center { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); width: 590px; max-width: calc(100vw - 24px); padding: 10px 12px; z-index: 26; }
    .skills-bar { display: grid; grid-template-columns: repeat(5, 1fr) auto auto; gap: 7px; align-items: stretch; }
    .skill-slot-wrap { position: relative; display: flex; }
    .skill-slot-wrap > .skill-btn { flex: 1; }
    .skill-upgrade-btn {
        position: absolute; top: -24px; left: 50%; transform: translateX(-50%);
        display: none; align-items: center; gap: 3px; white-space: nowrap;
        padding: 2px 9px; border-radius: 999px; font-size: 10px; font-weight: 800;
        background: linear-gradient(135deg, #f59e0b, #fde047); color: #0f172a;
        border: 1px solid #fef08a; box-shadow: 0 4px 14px rgba(250, 204, 21, 0.65);
        cursor: pointer; z-index: 8; animation: pulseGold 1.3s infinite;
    }
    .skill-upgrade-btn.visible { display: inline-flex; }
    .skill-upgrade-btn:hover { filter: brightness(1.1); transform: translateX(-50%) scale(1.06); }
    .skill-rank-badge {
        position: absolute; bottom: 3px; right: 5px; font-size: 9px; font-weight: 800;
        color: #94a3b8; background: rgba(4, 10, 18, 0.72); border-radius: 4px;
        padding: 0 3px; z-index: 3; border: 1px solid rgba(148,189,224,0.22);
    }
    .skill-rank-badge.upgraded { color: #fde047; border-color: rgba(250, 204, 21, 0.6); }
    #skill-upgrade-banner {
        display: none; margin-top: 7px; padding: 4px 10px; border-radius: 8px;
        background: rgba(250, 204, 21, 0.14); border: 1px solid rgba(250, 204, 21, 0.55);
        color: #fef08a; font-size: 11px; font-weight: 700; text-align: center;
    }
    #skill-upgrade-banner.visible { display: block; }
    .skill-btn {
        position: relative; overflow: hidden; border-radius: 10px;
        border: 1px solid rgba(148,189,224,0.35); background: rgba(15, 29, 44, 0.92);
        color: #fff; padding: 8px 6px; cursor: pointer; text-align: center;
        display: flex; flex-direction: column; align-items: center; gap: 2px;
        transition: transform 0.08s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .skill-btn:hover:not(.locked) { border-color: #5eead4; transform: translateY(-2px); }
    .skill-btn.locked { opacity: 0.42; cursor: not-allowed; }
    .skill-btn.skill-pressed {
        transform: scale(0.91);
        border-color: var(--skill-glow, #fde047);
        box-shadow: 0 0 18px var(--skill-glow, rgba(250,204,21,0.75)), inset 0 0 12px rgba(255,255,255,0.28);
    }
    .skill-btn.skill-cast-flash {
        animation: skillCastPop 0.36s cubic-bezier(0.22, 1.4, 0.36, 1);
    }
    .skill-btn.skill-rejected {
        animation: skillRejectShake 0.32s ease;
        border-color: #ef4444 !important;
        box-shadow: 0 0 14px rgba(239,68,68,0.65) !important;
    }
    .skill-btn.skill-ready-flash {
        animation: skillReadyPulse 0.45s ease-out;
    }
    @keyframes skillCastPop {
        0% { transform: scale(0.88); box-shadow: 0 0 0 0 var(--skill-glow, #f97316); filter: brightness(1.65); }
        45% { transform: scale(1.08); box-shadow: 0 0 22px 4px var(--skill-glow, #f97316); filter: brightness(1.3); }
        100% { transform: scale(1); box-shadow: none; filter: brightness(1); }
    }
    @keyframes skillRejectShake {
        0%, 100% { transform: translateX(0); }
        20% { transform: translateX(-5px); }
        45% { transform: translateX(5px); }
        70% { transform: translateX(-3px); }
        85% { transform: translateX(3px); }
    }
    @keyframes skillReadyPulse {
        0% { box-shadow: 0 0 0 0 rgba(250,204,21,0.85); border-color: #fde047; }
        50% { box-shadow: 0 0 16px 3px rgba(250,204,21,0.65); border-color: #fef08a; }
        100% { box-shadow: none; }
    }
    .skill-key { position: absolute; top: 4px; left: 6px; font-size: 10px; color: #94a3b8; font-weight: 700; z-index: 3; }
    .skill-mana { position: absolute; top: 4px; right: 6px; font-size: 10px; color: #38bdf8; font-weight: 700; z-index: 3; }
    .skill-icon { font-size: 21px; line-height: 1.1; margin-top: 4px; z-index: 2; transition: transform 0.12s ease; }
    .skill-btn.skill-pressed .skill-icon { transform: scale(1.18); }
    .skill-name { font-size: 10px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 92px; z-index: 2; }
    .skill-cd-sweep {
        position: absolute; left: 0; right: 0; bottom: 0; height: 0%;
        background: rgba(4, 10, 18, 0.72);
        border-top: 1px solid rgba(250, 204, 21, 0.55);
        pointer-events: none; z-index: 2; transition: height 0.06s linear;
    }
    .skill-cd-overlay {
        position: absolute; inset: 0; background: rgba(4, 9, 15, 0.32);
        display: none; align-items: center; justify-content: center;
        font-weight: 800; font-size: 16px; color: #fde047; text-shadow: 0 1px 4px #000; z-index: 4;
    }
    .skill-btn.on-cd .skill-cd-overlay { display: flex; }
    .char-sheet-btn {
        border-radius: 10px; border: 1px solid rgba(250, 204, 21, 0.45);
        background: rgba(30, 41, 59, 0.9); color: #fde047;
        padding: 0 11px; cursor: pointer; font-weight: 700; font-size: 12px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    }
    .char-sheet-btn.has-points { animation: pulseGold 1.4s infinite; }
    .mount-toggle-btn { border-color: rgba(251, 146, 60, 0.55); color: #fed7aa; }
    .mount-toggle-btn.mounted {
        background: rgba(234, 88, 12, 0.35); border-color: #fb923c; color: #fef08a;
        box-shadow: 0 0 12px rgba(251, 146, 60, 0.45);
    }
    @keyframes pulseGold { 0%,100% { box-shadow: 0 0 0 0 rgba(250,204,21,0.5); } 50% { box-shadow: 0 0 14px 3px rgba(250,204,21,0.55); } }
    .xp-bar { margin-top: 8px; height: 10px; background: rgba(0,0,0,0.6); border-radius: 99px; overflow: hidden; position: relative; border: 1px solid rgba(255,255,255,0.1); }
    .xp-fill { height: 100%; background: linear-gradient(90deg, #9333ea, #c084fc, #facc15); transition: width 0.3s ease; }
    .xp-text { position: absolute; inset: 0; font-size: 9px; display: flex; align-items: center; justify-content: center; font-weight: 700; text-shadow: 0 1px 2px #000; }

    /* Bottom-left: Chat */
    .hud-chat { position: absolute; bottom: 14px; left: 14px; width: 290px; padding: 8px; display: flex; flex-direction: column; gap: 6px; z-index: 22; }
    .chat-tabs { display: flex; gap: 4px; }
    .chat-tab {
        flex: 1; padding: 3px 6px; border-radius: 6px; border: 1px solid transparent;
        background: rgba(255,255,255,0.05); color: var(--text-muted); cursor: pointer; font-size: 11px;
    }
    .chat-tab.active { background: rgba(20, 184, 166, 0.25); border-color: rgba(94,234,212,0.5); color: #fff; }
    .chat-log { height: 116px; overflow-y: auto; font-size: 12px; line-height: 1.38; padding-right: 4px; }
    .chat-line { margin-bottom: 3px; word-break: break-word; }
    .chat-form { display: flex; gap: 5px; }
    .chat-form input {
        flex: 1; padding: 5px 8px; border-radius: 7px; border: 1px solid var(--border);
        background: rgba(0,0,0,0.55); color: #fff; font-size: 12px;
    }

    /* Bottom-right: Controls hint */
    .hud-controls {
        position: absolute; bottom: 14px; right: 14px; padding: 8px 10px;
        font-size: 11px; color: var(--text-muted); line-height: 1.5; max-width: 225px; z-index: 22;
    }
    @media (max-width: 1100px) {
        .hud-chat { bottom: 126px; width: 250px; }
        .chat-log { height: 84px; }
        .hud-controls { display: none; }
    }
    .hud-controls kbd {
        background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
        border-radius: 4px; padding: 0 4px; color: #e2e8f0; font-family: inherit; font-size: 10px;
    }

    /* Zone Banner & Toast */
    #zone-banner {
        position: absolute; top: 96px; left: 50%; transform: translateX(-50%);
        text-align: center; opacity: 0; transition: opacity 0.5s ease; pointer-events: none;
    }
    #zone-banner.show { opacity: 1; }
    #zone-banner h2 { margin: 0; font-size: 26px; letter-spacing: 0.06em; text-shadow: 0 3px 14px rgba(0,0,0,0.85); color: #fef3c7; }
    #zone-banner p { margin: 2px 0 0; font-size: 13px; color: #bae6fd; text-shadow: 0 2px 8px rgba(0,0,0,0.85); }
    #toast {
        position: absolute; bottom: 128px; left: 50%; transform: translateX(-50%);
        background: rgba(15, 23, 42, 0.92); border: 1px solid rgba(251, 146, 60, 0.6);
        color: #fed7aa; padding: 6px 14px; border-radius: 999px; font-weight: 600;
        opacity: 0; transition: opacity 0.25s; pointer-events: none;
    }
    #toast.show { opacity: 1; }

    /* Floating Combat Text & Nameplates */
    .fct {
        position: absolute; font-weight: 800; text-shadow: 0 2px 4px #000;
        transform: translate(-50%, -50%); white-space: nowrap;
        animation: floatUp 1.2s ease-out forwards;
    }
    @keyframes floatUp {
        0% { opacity: 1; transform: translate(-50%, -50%) scale(0.9); }
        25% { opacity: 1; transform: translate(-50%, -85%) scale(1.15); }
        100% { opacity: 0; transform: translate(-50%, -170%) scale(0.95); }
    }
    .nameplate {
        position: absolute; transform: translate(-50%, -100%);
        text-align: center; white-space: nowrap; pointer-events: none;
    }
    .np-label { font-size: 11px; font-weight: 700; text-shadow: 0 1px 3px #000, 0 0 6px #000; padding: 1px 5px; border-radius: 4px; }
    .np-hp { width: 64px; height: 5px; background: rgba(0,0,0,0.75); border-radius: 3px; margin: 2px auto 0; overflow: hidden; border: 1px solid rgba(255,255,255,0.2); }
    .np-hp > i { display: block; height: 100%; }

    /* Modals */
    .modal-backdrop {
        position: fixed; inset: 0; background: rgba(2, 6, 12, 0.68);
        display: none; align-items: center; justify-content: center; z-index: 40; pointer-events: auto;
    }
    .modal-backdrop.open { display: flex; }
    .modal-card {
        width: 430px; max-width: 92vw; padding: 1.4rem;
        background: #0b1824; border: 1px solid rgba(148,189,224,0.35); border-radius: 16px;
        box-shadow: 0 24px 60px rgba(0,0,0,0.65);
    }
    .attr-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 7px 10px; border-radius: 9px; background: rgba(255,255,255,0.04); margin-bottom: 6px;
    }
    .derived-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 10px; font-size: 12px; color: var(--text-muted); }
    .derived-grid strong { color: #e2e8f0; }

    #loading-screen {
        position: fixed; inset: 0; z-index: 60; background: #07111a;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px;
    }
</style>
{% endblock %}

{% block body %}
<div id="loading-screen">
    <h1 style="margin:0; font-size:2rem; color:#5eead4;">SymfonyForever</h1>
    <p id="loading-status" style="color:#93adc2; margin:0;">Chargement du relief 3D de La Réunion...</p>
</div>

<canvas id="game-viewport"
        data-character-id="{{ character.id }}"
        data-character-name="{{ character.name|e('html_attr') }}"
        data-class-code="{{ character.classCode }}"
        data-admin-unlocked="{{ adminUnlocked|default(false) ? '1' : '0' }}"></canvas>

<div id="floating-layer"></div>

<div id="hud">
    <!-- Top Left: Player & Party -->
    <div class="hud-top-left">
        <div class="hud-box unit-frame">
            <div class="unit-head">
                <div class="unit-name">
                    <span id="hud-class-dot" style="width:10px;height:10px;border-radius:50%;display:inline-block;background:#38bdf8;"></span>
                    <span id="hud-name">{{ character.name }}</span>
                </div>
                <div style="display:flex; align-items:center; gap:6px;">
                    <span class="gold-pill" id="hud-gold">🪙 25</span>
                    <span class="lvl-badge">Niv. <span id="hud-level">{{ character.level }}</span></span>
                </div>
            </div>
            <div class="bar bar-hp"><div class="bar-fill" id="hud-hp-fill" style="width:100%"></div><div class="bar-label" id="hud-hp-text">-- / --</div></div>
            <div class="bar bar-mp"><div class="bar-fill" id="hud-mp-fill" style="width:100%"></div><div class="bar-label" id="hud-mp-text">-- / --</div></div>
            <div class="buff-row" id="hud-buffs"></div>
        </div>

        <div class="hud-box party-box">
            <div class="party-head">
                <span>Groupe / Raid (max 10)</span>
                <button class="mini-btn mini-btn-red" id="btn-party-leave" style="display:none;">Quitter</button>
            </div>
            <div id="party-invite-banner" style="display:none; margin-bottom:6px; padding:6px; border-radius:8px; background:rgba(20,184,166,0.18); border:1px solid #2dd4bf;">
                <div style="font-size:11px; margin-bottom:4px;" id="party-invite-text">Invitation de groupe</div>
                <div style="display:flex; gap:5px;">
                    <button class="mini-btn" id="btn-party-accept">Accepter</button>
                    <button class="mini-btn mini-btn-red" id="btn-party-decline">Refuser</button>
                </div>
            </div>
            <div id="party-members"><div style="color:var(--text-muted); font-size:11px;">En solo — alliez-vous jusqu'à 10 joueurs pour vaincre le World Boss et gagner un LÉGENDAIRE garanti !</div></div>
            <form class="party-invite-row" id="party-invite-form">
                <input type="text" id="party-invite-input" placeholder="Inviter un joueur...">
                <button type="submit" class="mini-btn">+ Inviter</button>
            </form>
        </div>
    </div>

    <!-- Admin Atmosphere Floating Panel (/iddad) -->
    <div class="hud-box" id="admin-atmosphere-panel">
        <div class="admin-panel-head">
            <div class="admin-panel-title">🛠️ Admin Atmosphère</div>
            <div style="display:flex; align-items:center; gap:5px;">
                <span class="admin-panel-badge">Commun · Toute l'île</span>
                <button type="button" class="mini-btn" id="btn-close-admin-panel" title="Fermer le panneau">×</button>
            </div>
        </div>
        <div>
            <div class="admin-section-label">
                <span>🌦️ Météo globale</span>
                <span id="admin-weather-mode-badge" style="color:#5eead4;">Auto</span>
            </div>
            <div class="admin-btn-grid">
                <button type="button" class="admin-btn admin-weather-btn" data-weather="AUTO">✨ Auto</button>
                <button type="button" class="admin-btn admin-weather-btn" data-weather="CLEAR">☀️ Clair</button>
                <button type="button" class="admin-btn admin-weather-btn" data-weather="RAIN">🌧️ Pluie</button>
                <button type="button" class="admin-btn admin-weather-btn" data-weather="STORM">⛈️ Orage</button>
                <button type="button" class="admin-btn admin-weather-btn" data-weather="SANDSTORM">🌪️ Sable</button>
            </div>
        </div>
        <div>
            <div class="admin-section-label"><span>🕒 Cycle Jour / Nuit global</span></div>
            <div class="admin-time-readout-row">
                <span id="admin-time-readout">12:00 · Jour</span>
                <span id="admin-time-mode-badge">Auto</span>
            </div>
            <input type="range" id="admin-time-slider" min="0" max="1439" step="5" value="720" aria-label="Heure globale de l'île">
            <div class="admin-preset-grid" style="margin-bottom:6px;">
                <button type="button" class="admin-btn admin-time-preset" data-time="6.35">🌅 Aube</button>
                <button type="button" class="admin-btn admin-time-preset" data-time="12.5">☀️ Midi</button>
                <button type="button" class="admin-btn admin-time-preset" data-time="18.35">🌇 Soir</button>
                <button type="button" class="admin-btn admin-time-preset" data-time="23">🌙 Nuit</button>
            </div>
            <div class="admin-btn-row">
                <button type="button" class="admin-btn warn" id="btn-admin-freeze-time">⏸️ Figer l'heure</button>
                <button type="button" class="admin-btn" id="btn-admin-time-auto">🔄 Heure Auto</button>
            </div>
        </div>
        <button type="button" class="admin-btn" id="btn-admin-reset-all" style="border-color:rgba(94,234,212,0.45); color:#99f6e4;">♻️ Tout remettre en Auto</button>
    </div>

    <!-- Top Center: Target & World Boss Raid Bar -->
    <div class="hud-box unit-frame hud-target" id="target-frame">
        <div class="unit-head">
            <div class="unit-name" id="target-name">Cible</div>
            <span class="lvl-badge" id="target-lvl">Niv. 1</span>
        </div>
        <div class="bar bar-hp-enemy" id="target-hp-bar"><div class="bar-fill" id="target-hp-fill" style="width:100%"></div><div class="bar-label" id="target-hp-text">--</div></div>
        <div class="aggro-tag" id="target-aggro"></div>
        <button type="button" class="mini-btn" id="btn-target-invite" style="display:none; margin-top:5px; width:100%;">+ Inviter dans le groupe</button>
    </div>

    <div class="hud-box" id="world-boss-hud">
        <div class="wb-head">
            <div class="wb-title">🌋 <span id="wb-name">Seigneur du Dolomieu (World Boss)</span></div>
            <span class="wb-badge" id="wb-phase-badge">RAID 10 JOUEURS</span>
        </div>
        <div class="wb-bar">
            <div class="wb-bar-fill" id="wb-hp-fill" style="width:100%"></div>
            <div class="wb-bar-notch" title="Seuil Phase 2 : Fureur Magmatique (50%)"></div>
            <div class="bar-label" id="wb-hp-text">440 000 / 440 000 (100%)</div>
        </div>
        <div class="wb-meta">
            <span class="wb-pill" id="wb-allies">👥 0 / 10 Alliés</span>
            <span class="wb-pill warn" id="wb-carapace">🛡️ Carapace : 3+ joueurs requis</span>
            <span class="wb-pill leg">🏆 1× LÉGENDAIRE garanti</span>
        </div>
    </div>

    <!-- Top Right: Minimap & Quest Tracker -->
    <div class="hud-top-right-col">
        <div class="hud-box hud-top-right">
            <div class="zone-header">
                <div>
                    <div class="zone-title" id="zone-name">Lagon de l'Ouest</div>
                    <div class="zone-sub" id="zone-sub">Niv. 1–10</div>
                </div>
                <a href="{{ path('app_characters') }}" class="mini-btn" title="Retour au Lobby">Lobby</a>
            </div>
            <canvas id="minimap-canvas" width="208" height="208"></canvas>
            <div id="wb-minimap-pill" title="Cliquer pour préparer le voyage vers le Piton de la Fournaise (World Boss 10 joueurs · 1× Légendaire garanti)">
                <span>🌋 Dolomieu</span>
                <strong id="wb-minimap-status">Actif</strong>
            </div>
            <div class="atmo-row" id="hud-atmosphere" title="Cycle jour/nuit &amp; météo communs à toute l'île">
                <span>☀️ 12:00</span>
                <span>Ciel clair</span>
            </div>
            <button type="button" class="mini-btn" id="btn-admin-toggle" style="display:none; width:100%;" title="Ouvrir / fermer le panneau Admin Atmosphère">🛠️ Admin Météo / Heure</button>
            <div class="travel-row">
                <select id="travel-select" title="Relais des Cirques (Voyage rapide hors combat)"></select>
                <button type="button" class="mini-btn" id="btn-travel">Voyager</button>
            </div>
            <div class="net-row">
                <span><i class="net-dot" id="net-dot"></i><span id="net-ping">HTTP Sync</span></span>
                <span id="hud-online-count" style="color:#86efac; font-weight:600;">👥 -- en ligne</span>
                <span id="hud-coords">0, 0</span>
            </div>
        </div>

        <div class="hud-box quest-tracker" id="quest-tracker">
            <div class="qt-head">
                <span>📜 Quêtes de l'Île</span>
                <span id="qt-counter" style="color:#93adc2;">0/10</span>
            </div>
            <div id="qt-body"></div>
        </div>
    </div>

    <!-- NPC & Loot Proximity Prompts -->
    <button type="button" id="loot-pickup-prompt">💰 Appuyez sur [F] pour ramasser</button>
    <button type="button" id="npc-interact-prompt">💬 Appuyez sur [F] pour parler</button>

    <!-- Zone Banner & Toast -->
    <div id="zone-banner">
        <h2 id="zone-banner-title">Lagon de l'Ouest</h2>
        <p id="zone-banner-sub">Saint-Gilles &amp; Ermitage · Niv. 1–3</p>
    </div>
    <div id="toast"></div>

    <!-- Bottom Center: Skills + XP -->
    <div class="hud-box hud-bottom-center">
        <div class="skills-bar">
            <button type="button" class="skill-btn" id="skill-slot-aa"></button>
            <div class="skill-slot-wrap">
                <button type="button" class="skill-upgrade-btn" data-upgrade-slot="1" id="skill-upgrade-1">▲ +1</button>
                <button type="button" class="skill-btn" data-slot="1" id="skill-slot-1"></button>
            </div>
            <div class="skill-slot-wrap">
                <button type="button" class="skill-upgrade-btn" data-upgrade-slot="2" id="skill-upgrade-2">▲ +1</button>
                <button type="button" class="skill-btn" data-slot="2" id="skill-slot-2"></button>
            </div>
            <div class="skill-slot-wrap">
                <button type="button" class="skill-upgrade-btn" data-upgrade-slot="3" id="skill-upgrade-3">▲ +1</button>
                <button type="button" class="skill-btn" data-slot="3" id="skill-slot-3"></button>
            </div>
            <div class="skill-slot-wrap">
                <button type="button" class="skill-upgrade-btn" data-upgrade-slot="4" id="skill-upgrade-4">▲ +1</button>
                <button type="button" class="skill-btn" data-slot="4" id="skill-slot-4"></button>
            </div>
            <button type="button" class="char-sheet-btn mount-toggle-btn" id="btn-mount-toggle" title="Monter / Descendre de monture (C)">
                <span>🐎 Monture</span>
                <small id="mount-key-badge">[C]</small>
            </button>
            <button type="button" class="char-sheet-btn" id="btn-char-sheet" title="Fiche Personnage (P)">
                <span>Stats</span>
                <small id="stat-pts-badge">[P]</small>
            </button>
            <button type="button" class="char-sheet-btn" id="btn-bag-modal" style="border-color:rgba(94,234,212,0.5); color:#5eead4;" title="Sac & Équipement (I)">
                <span>🎒 Sac</span>
                <small id="bag-count-badge">0/24</small>
            </button>
        </div>
        <div id="skill-upgrade-banner">✨ <span id="skill-upgrade-text">1 pt de compétence</span> — Cliquez sur <strong>▲ +1</strong> pour renforcer un sort (+22%) !</div>
        <div class="xp-bar">
            <div class="xp-fill" id="hud-xp-fill" style="width:0%"></div>
            <div class="xp-text" id="hud-xp-text">XP 0 / 100</div>
        </div>
    </div>

    <!-- Bottom Left: Chat -->
    <div class="hud-box hud-chat">
        <div class="chat-tabs">
            <button type="button" class="chat-tab active" data-channel="ZONE">Zone</button>
            <button type="button" class="chat-tab" data-channel="GLOBAL">Global</button>
            <button type="button" class="chat-tab" data-channel="PARTY">Groupe</button>
            <button type="button" class="chat-tab" data-channel="COMBAT">Combat</button>
        </div>
        <div class="chat-log" id="chat-log"></div>
        <form class="chat-form" id="chat-form">
            <input type="text" id="chat-input" maxlength="260" placeholder="Message (Entrée pour parler)...">
            <button type="submit" class="mini-btn">Envoyer</button>
        </form>
    </div>

    <!-- Bottom Right: Controls -->
    <div class="hud-box hud-controls">
        <div><kbd>Z</kbd><kbd>Q</kbd><kbd>S</kbd><kbd>D</kbd> Marcher · <kbd>Shift</kbd> Sprint · <kbd>Espace</kbd> Sauter / Monter (Vol) · <kbd>Ctrl</kbd> Descendre</div>
        <div><kbd>Clic droit</kbd> Caméra · <kbd>Molette</kbd> Zoom</div>
        <div><kbd>Tab</kbd> / <kbd>Clic G.</kbd> Cibler &amp; Auto-attaque · <kbd>1</kbd>-<kbd>4</kbd> Sorts</div>
        <div><kbd>F</kbd> Interagir (PNJ / Loot) · <kbd>C</kbd> Monture · <kbd>I</kbd> Sac · <kbd>P</kbd> Stats</div>
    </div>
</div>

<!-- Inventory & Equipment Modal (I) -->
<div class="modal-backdrop" id="bag-modal">
    <div class="modal-card" style="width:680px; max-width:95vw; max-height:86vh; overflow-y:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div>
                <h2 style="margin:0; font-size:1.2rem; color:#5eead4;">🎒 Sac &amp; Équipement</h2>
                <div style="font-size:0.82rem; color:var(--text-muted); margin-top:2px;">
                    Or : <strong class="gold-pill" id="bag-modal-gold">🪙 0</strong> ·
                    Emplacements : <strong id="bag-modal-slots" style="color:#e2e8f0;">0 / 24</strong>
                </div>
            </div>
            <button type="button" class="mini-btn" id="btn-close-bag-modal">Fermer (I)</button>
        </div>
        <div class="inv-layout">
            <div>
                <div style="font-size:11px; text-transform:uppercase; color:#fde047; font-weight:700; margin-bottom:6px; letter-spacing:0.06em;">Équipé</div>
                <div id="bag-equipped-list"></div>
            </div>
            <div>
                <div style="font-size:11px; text-transform:uppercase; color:#5eead4; font-weight:700; margin-bottom:6px; letter-spacing:0.06em;">Sac à dos</div>
                <div class="bag-list" id="bag-items-list"></div>
            </div>
        </div>
    </div>
</div>

<!-- NPC Quest & Vendor Dialogue Modal (E) -->
<div class="modal-backdrop" id="npc-modal">
    <div class="modal-card" style="width:560px; max-width:95vw; max-height:86vh; overflow-y:auto;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:8px;">
            <div>
                <h2 style="margin:0; font-size:1.22rem; color:#fde047;" id="npc-modal-name">PNJ</h2>
                <div style="font-size:0.8rem; color:#5eead4;" id="npc-modal-title"></div>
            </div>
            <button type="button" class="mini-btn" id="btn-close-npc-modal">Fermer (Échap)</button>
        </div>
        <p id="npc-modal-greeting" style="margin:0 0 10px; font-size:0.86rem; color:#e2e8f0; font-style:italic; background:rgba(255,255,255,0.04); padding:8px 11px; border-radius:9px;"></p>
        <div class="modal-tabs">
            <button type="button" class="modal-tab active" data-npc-tab="QUESTS">📜 Quêtes</button>
            <button type="button" class="modal-tab" data-npc-tab="VENDOR">🪙 Marchand (Vendre &amp; Acheter)</button>
        </div>
        <div id="npc-modal-quests"></div>
        <div id="npc-modal-vendor" style="display:none;"></div>
    </div>
</div>

<!-- Character Stats Modal -->
<div class="modal-backdrop" id="char-modal">
    <div class="modal-card" style="width:470px; max-width:94vw; max-height:86vh; overflow-y:auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
            <h2 style="margin:0; font-size:1.2rem;">Fiche de <span id="modal-char-name"></span></h2>
            <button type="button" class="mini-btn" id="btn-close-char-modal">Fermer (P)</button>
        </div>
        <div style="font-size:0.88rem; color:var(--text-muted); margin-bottom:12px;">
            Niveau <strong id="modal-lvl" style="color:#fde047;">1</strong> ·
            Stats : <strong id="modal-stat-pts" style="color:#34d399;">0</strong> ·
            Compétences <small>(1 pt / 3 niv.)</small> : <strong id="modal-skill-pts" style="color:#fde047;">0</strong>
        </div>
        <div id="modal-attributes"></div>
        <div style="font-size:11px; text-transform:uppercase; color:#fde047; font-weight:700; margin:12px 0 6px; letter-spacing:0.06em;">Rang des Compétences (+22% puissance / rang)</div>
        <div id="modal-skills-upgrade"></div>
        <div class="derived-grid" id="modal-derived"></div>
    </div>
</div>

<!-- Death Modal -->
<div class="modal-backdrop" id="death-modal">
    <div class="modal-card" style="text-align:center;">
        <h2 style="margin:0 0 8px; color:#f87171;">Vous avez été vaincu !</h2>
        <p style="color:var(--text-muted); font-size:0.9rem; margin:0 0 16px;">
            L'esprit de l'île vous ramènera au camp sûr de votre zone sans perte de niveau.
        </p>
        <button type="button" class="btn btn-lagoon" id="btn-respawn" style="width:100%;">Ressusciter au Camp</button>
    </div>
</div>
