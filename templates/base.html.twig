<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SymfonyForever — MMO 3D La Réunion{% endblock %}</title>
    <style>
        :root {
            --bg-deep: #07111a;
            --bg-panel: rgba(11, 22, 34, 0.88);
            --bg-panel-solid: #0c1926;
            --border: rgba(148, 189, 224, 0.22);
            --accent-lava: #f97316;
            --accent-lagoon: #14b8a6;
            --accent-tank: #38bdf8;
            --accent-heal: #10b981;
            --accent-gold: #facc15;
            --text-main: #e8f1f8;
            --text-muted: #93adc2;
        }
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: radial-gradient(circle at 20% 15%, #12324c 0%, #07111a 55%, #1b0e0d 100%);
            color: var(--text-main);
        }
        a { color: #5eead4; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.65rem 1.2rem;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: linear-gradient(135deg, #0ea5e9, #0284c7);
            color: #fff;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.12s ease, filter 0.15s ease;
        }
        .btn:hover { filter: brightness(1.12); transform: translateY(-1px); text-decoration: none; }
        .btn-lava { background: linear-gradient(135deg, #f97316, #dc2626); }
        .btn-lagoon { background: linear-gradient(135deg, #10b981, #0d9488); }
        .btn-ghost { background: rgba(255,255,255,0.06); color: var(--text-main); }
        .btn-danger { background: rgba(220, 38, 38, 0.22); border-color: rgba(239, 68, 68, 0.45); color: #fca5a5; }
        .flash {
            padding: 0.75rem 1rem;
            border-radius: 10px;
            margin-bottom: 1rem;
            font-size: 0.92rem;
        }
        .flash-error { background: rgba(220, 38, 38, 0.2); border: 1px solid rgba(248, 113, 113, 0.45); color: #fecaca; }
        .flash-success { background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(52, 211, 153, 0.45); color: #a7f3d0; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {% block body %}{% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
